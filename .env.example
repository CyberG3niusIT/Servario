# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=servario
POSTGRES_USER=servario
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://servario:change_me_in_production@db:5432/servario

# ─── Application ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_characters
ENVIRONMENT=production
# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=https://yourdomain.com

# ─── License ─────────────────────────────────────────────────────────────────
# Base64-encoded Ed25519-signed license JSON — obtain from the Servario license portal
# Leave empty to run in Demo/Eval mode (max 5 bookings, 2 staff, 3 services, 30 days)
SERVARIO_LICENSE_KEY=

# Optional: URL of the Servario License Broker for online validation
# Leave empty to use local-only Ed25519 signature validation
SERVARIO_LICENSE_SERVER_URL=

# Unique identifier for this installation (auto-generated UUID on first start)
# Set explicitly for reproducible infrastructure-as-code deployments
SERVARIO_INSTANCE_ID=

# Days of offline operation before online revalidation is required (default: 30, range: 1-90)
SERVARIO_LICENSE_OFFLINE_GRACE_DAYS=30

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ─── SMTP (can also be configured via Admin UI after first start) ─────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=

# NOTE: This file must NEVER contain RevenueCat API keys, webhook secrets,
# or License Broker credentials. Those belong exclusively to the License Broker
# service operated by the Servario vendor.
